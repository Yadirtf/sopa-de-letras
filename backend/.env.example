# WordHive Backend — Variables de Entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env al repositorio

NODE_ENV=development
PORT=3000

# PostgreSQL (Render proporciona esta URL automaticamente)
DATABASE_URL="postgresql://user:password@host:5432/wordhive?schema=public"

# Redis (Render proporciona esta URL automaticamente)
REDIS_URL="redis://default:password@host:6379"

# JWT — usar un secreto de minimo 32 caracteres
JWT_SECRET="tu-secreto-super-largo-aqui-minimo-32-caracteres"
JWT_ACCESS_EXPIRY="7d"
JWT_REFRESH_EXPIRY="30d"

# Nodemailer SMTP (Gmail: genera una App Password en myaccount.google.com)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="wordhive.noreply@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="WordHive <wordhive.noreply@gmail.com>"

# URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

