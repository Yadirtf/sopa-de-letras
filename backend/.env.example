# WordHive Backend — Variables de Entorno (Local & Render.com)
# Para entorno local: copia este archivo como .env y rellena tus valores
# Para Render.com: configúralos en el Dashboard o usa render.yaml Blueprint

NODE_ENV=production
PORT=3000

# Base de datos PostgreSQL (Render PostgreSQL proporciona esta URL automáticamente)
DATABASE_URL="postgresql://wordhive_user:password@wordhive-db:5432/wordhive?schema=public"

# Redis Cache (Render Key-Value o Redis Cloud proporciona esta URL automáticamente)
REDIS_URL="redis://default:password@wordhive-redis:6379"

# Criptografía JWT (Mínimo 32 caracteres seguros)
JWT_SECRET="wordhive-ultra-secure-jwt-secret-key-production-32-chars-min"
JWT_ACCESS_EXPIRY="7d"
JWT_REFRESH_EXPIRY="30d"

# Servicio de Correo Transaccional (Para recuperación de PIN vía OTP)
# En Render puedes usar Resend, SendGrid o Gmail App Password:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="wordhive.noreply@gmail.com"
SMTP_PASS="tu-contraseña-de-aplicacion-16-caracteres"
SMTP_FROM="WordHive <wordhive.noreply@gmail.com>"

# URLs de los servicios desplegados en Render
APP_URL="https://wordhive-api.onrender.com"
FRONTEND_URL="https://wordhive-landing.onrender.com"
