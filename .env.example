# ==========================================
# Configuración Sopa de Letras Online
# ==========================================

# Base de datos
POSTGRES_USER=sopadeletras
POSTGRES_PASSWORD=sopadeletras_pass
POSTGRES_DB=sopadeletras
PORT_DB_HOST=5433

# Seguridad JWT
JWT_SECRET=cambia-este-secreto-en-produccion-abc123

# Backend interno
API_PORT=3001

# Mapeo de Puertos al Host (Opcional si usas Nginx Proxy Manager en proxy-network)
# Usamos 3005 para la API para evitar conflictos si el puerto 3001 está en uso en el host
PORT_API_HOST=3005
PORT_WEB_HOST=5174

# Dominios DuckDNS (Frontend y Backend)
# Ajusta con tus subdominios reales de DuckDNS si deseas que el cliente web se conecte directamente
# a la API con HTTPS.
# Si los dejas vacíos, la web usará URLs relativas (/api y /socket.io) a través del Nginx del contenedor web.
VITE_API_URL=https://abc-api.duckdns.org
VITE_WS_URL=https://abc-api.duckdns.org
